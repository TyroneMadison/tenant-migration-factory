{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tenant migration definition",
  "description": "Single source of truth for one customer moving from a legacy single-tenant environment into the shared multi-tenant platform.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant", "source", "target", "database", "cutover"],
  "properties": {
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tier"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,30}$" },
        "name": { "type": "string", "minLength": 2 },
        "tier": { "type": "string", "enum": ["standard", "premium", "gov"] },
        "owner_email": { "type": "string", "format": "email" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform"],
      "properties": {
        "platform": { "type": "string", "enum": ["onprem", "aws", "azure"] },
        "os": { "type": "string", "enum": ["linux", "windows"] },
        "region": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloud", "environment"],
      "properties": {
        "cloud": { "type": "string", "enum": ["aws", "azure"] },
        "environment": { "type": "string", "enum": ["dev", "qa", "staging", "prod"] },
        "region": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "size_gb"],
      "properties": {
        "engine": { "type": "string", "enum": ["mysql", "sqlserver"] },
        "size_gb": { "type": "number", "minimum": 1 },
        "downtime_budget_minutes": { "type": "number", "minimum": 0 }
      }
    },
    "cutover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window"],
      "properties": {
        "window": { "type": "string", "enum": ["anytime", "weeknight", "weekend"] },
        "compliance": {
          "type": "array",
          "items": { "type": "string", "enum": ["itar", "cui", "fedramp"] },
          "uniqueItems": true
        }
      }
    }
  }
}
